{
  "name": "calcolatore-subnet",
  "version": "0.1.0",
  "description": "Calcolatore Subnet IPv4: calcolo rapido, didattica e lavoro professionale, in un unico file HTML",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Paolo Pallavera",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "tsc -p jsconfig.json",
    "build": "vite build",
    "size": "node tools/size-check.js",
    "oracle": "python3 tools/oracle.py",
    "demo": "node tools/demo.js",
    "e2e": "npm run build && node tools/e2e.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "fast-check": "4.10.3",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.1"
  }
}
